class VAE(nn.Module):
  def __init__(self, hidden=2):
    super().__init__()
    self.fc1 = nn.Linear(784,256)
    self.fc_mu = nn.Linear(256, hidden)
    self.fc_logvar = nn.Linear(256, hidden)
    # Decoder reuses fc_mu.weight transposed (tied weights, like toy model of superposition)
    # Only a separate bias is needed for the decoder's hidden layer
    self.dec_bias = nn.Parameter(torch.zeros(256))
    self.fc3 = nn.Linear(256,784)

  def encoder(self, x):
    x = x.view(x.size(0), -1)
    h = F.relu(self.fc1(x))
    mu = self.fc_mu(h)
    logvar = self.fc_logvar(h)
    return mu, logvar

  def reparameterize(self, mu, logvar):
    std = torch.exp(0.5*logvar)
    eps = torch.randn_like(std)
    return mu + eps*std

  def decode(self, z):
    # Tied weights: use W^T where W = fc_mu.weight (shape 2×256)
    # F.linear(z, W^T) computes z @ W = (batch,2) @ (2,256) = (batch,256)
    h = F.relu(F.linear(z, self.fc_mu.weight.t(), self.dec_bias))
    x_hat = torch.sigmoid(self.fc3(h))
    return x_hat.view(-1, 1, 28, 28)

  def forward(self, x):
    mu, logvar = self.encoder(x)
    z = self.reparameterize(mu, logvar)
    x_hat = self.decode(z)
    return x_hat, mu, logvar, z

def vae_loss(reconstructed, x, mu , logvar):
  reconstruction_loss = F.binary_cross_entropy(reconstructed, x, reduction="sum")
  kl_divergence = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp())
  return reconstruction_loss + kl_divergence, reconstruction_loss, kl_divergence

  vae = VAE(hidden=2).to(device)
optimizer = torch.optim.Adam(vae.parameters(), lr=1e-3)

def train_vae(model, loader, optimizer, epochs=5):
  model.train()

  for epoch in range(epochs):
    total_loss = 0
    total_kl_loss = 0
    total_reconstruction_loss = 0
    for images, _ in loader:
      images = images.to(device)
      reconstructed, mu, logvar, _ = model(images)
      loss, reconstruction_loss, kl_divergence = vae_loss(reconstructed, images, mu, logvar)
      optimizer.zero_grad()
      loss.backward()
      optimizer.step()

      total_loss += loss.item()
      total_kl_loss += kl_divergence.item()
      total_reconstruction_loss += reconstruction_loss.item()

    n = len(loader.dataset)
    avg_loss = total_loss / n
    avg_kl_loss = total_kl_loss / n
    avg_reconstruction_loss = total_reconstruction_loss / n

    print(f"Epoch {epoch+1}/{epochs}, Loss: {avg_loss:.4f}, KL Loss: {avg_kl_loss:.4f}, Reconstruction Loss: {avg_reconstruction_loss:.4f}")
